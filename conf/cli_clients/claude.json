{
  "name": "claude",
  "command": "claude",
  "additional_args": [
    "--permission-mode",
    "acceptEdits",
    "-p",
    "--output-format",
    "stream-json",
    "--verbose",
    "--include-partial-messages"
  ],
  "env": {
    "CI": "true",
    "NO_COLOR": "true"
  },
  "roles": {
    "default": {
      "prompt_path": "systemprompts/clink/default.txt",
      "role_args": ["--settings", "/home/htanji/.claude/settings.json.gemini"]
    },
    "planner": {
      "prompt_path": "systemprompts/clink/default_planner.txt",
      "role_args": ["--settings", "/home/htanji/.claude/settings.json.thinking"]
    },
    "codereviewer": {
      "prompt_path": "systemprompts/clink/default_codereviewer.txt",
      "role_args": ["--settings", "/home/htanji/.claude/settings.json.thinking"]
    },
    "pro": {
      "prompt_path": "systemprompts/clink/default_codereviewer.txt",
      "role_args": [
    	"--model",
	"claude-sonnet-4-5-20250929"
      ]
    },
    "developer": {
      "prompt_path": "systemprompts/clink/default.txt",
      "role_args": ["--settings", "/home/htanji/.claude/settings.json.gemini"]
    }
  }
}
