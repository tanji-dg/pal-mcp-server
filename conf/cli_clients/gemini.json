{
  "name": "gemini",
  "command": "gemini",
  "additional_args": [
    "--yolo",
    "--exit-on-error"
  ],
  "env": {},
  "roles": {
    "default": {
      "prompt_path": "systemprompts/clink/default.txt",
      "role_args": [
        "--model",
        "gemini-3-flash-preview"
