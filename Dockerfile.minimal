# ===========================================
# STAGE 1: Dependency image (Local copy strategy)
# ===========================================
FROM node:20-slim AS node-runtime

# ===========================================
# STAGE 2: Final Integrated Image
# ===========================================
FROM python:3.11-slim
LABEL version="1.0.0-integrated-user1000"

# Create user with UID 1000 to match host
RUN groupadd -g 1000 paluser && useradd -u 1000 -g 1000 -m -r paluser
WORKDIR /app

# Copy Node.js binary and modules
COPY --from=node-runtime /usr/local/bin/node /usr/local/bin/
COPY --from=node-runtime /usr/local/lib/node_modules /usr/local/lib/node_modules
RUN ln -s /usr/local/lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm && \
    ln -s /usr/local/lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx

# Copy source files
COPY --chown=paluser:paluser server.py config.py requirements.txt requirements-monitor.txt ./
COPY --chown=paluser:paluser clink/ ./clink/
COPY --chown=paluser:paluser providers/ ./providers/
COPY --chown=paluser:paluser tools/ ./tools/
COPY --chown=paluser:paluser utils/ ./utils/
COPY --chown=paluser:paluser monitor/ ./monitor/
COPY --chown=paluser:paluser conf/ ./conf/
COPY --chown=paluser:paluser systemprompts/ ./systemprompts/

# Environment
ENV NPM_CONFIG_PREFIX=/home/paluser/.npm-global
ENV PATH=/home/paluser/.npm-global/bin:$PATH
ENV PYTHONUNBUFFERED=1 PYTHONPATH=/app TZ=Asia/Tokyo

RUN mkdir -p logs tmp && chown -R paluser:paluser logs tmp /home/paluser

USER paluser
CMD ["python", "server.py"]