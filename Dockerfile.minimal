# ===========================================
# STAGE 1: Extract Node.js Runtime (Alpine)
# ===========================================
FROM node:20-alpine AS node-env
# No pre-installation here. We only need the base Node.js and npm.

# ===========================================
# STAGE 2: Python Build Environment (Alpine)
# ===========================================
FROM python:3.11-alpine AS python-env

# ===========================================
# STAGE 3: Final Integrated Alpine Image
# ===========================================
# Use python:3.11-alpine as base to ensure full Python compatibility (headers, libs)
FROM python:3.11-alpine
LABEL version="1.0.0-integrated-alpine-v5-minimal"

# Create user (Ensure UID 1000 match to fix permission issues with host volumes)
RUN addgroup -g 1000 -S paluser && \
    adduser -u 1000 -S paluser -G paluser

WORKDIR /app

# 1. Copy Node.js binary and core libs from Node image
COPY --from=node-env /usr/local/bin/node /usr/local/bin/
COPY --from=node-env /usr/local/lib/node_modules /usr/local/lib/node_modules
RUN ln -s /usr/local/lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm && \
    ln -s /usr/local/lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx

# 2. Add C++ libs required by Node.js (libstdc++, libgcc_s) from node image
COPY --from=node-env /usr/lib/libstdc++.so.6 /usr/lib/
COPY --from=node-env /usr/lib/libgcc_s.so.1 /usr/lib/

# 3. Copy local packages for runtime installation
COPY --chown=paluser:paluser gemini-core.tgz /app/packages/gemini-core.tgz
COPY --chown=paluser:paluser gemini-cli.tgz /app/packages/gemini-cli.tgz

# 4. Copy source files
COPY --chown=paluser:paluser server.py config.py requirements.txt requirements-monitor.txt ./
COPY --chown=paluser:paluser clink/ ./clink/
COPY --chown=paluser:paluser providers/ ./providers/
COPY --chown=paluser:paluser tools/ ./tools/
COPY --chown=paluser:paluser utils/ ./utils/
COPY --chown=paluser:paluser monitor/ ./monitor/
COPY --chown=paluser:paluser conf/ ./conf/
COPY --chown=paluser:paluser systemprompts/ ./systemprompts/

# 実行環境設定
# Install libraries to /app to avoid conflicts with host volume mounts
ENV NPM_CONFIG_PREFIX=/app/.npm-global
ENV PYTHONUSERBASE=/app/.pylibs
ENV PATH=/app/.npm-global/bin:/app/.pylibs/bin:$PATH
ENV PYTHONUNBUFFERED=1 PYTHONPATH=/app TZ=Asia/Tokyo

RUN mkdir -p logs tmp .npm-global .pylibs && \
    chown -R paluser:paluser logs tmp .npm-global .pylibs /home/paluser

USER paluser
CMD ["python3", "server.py"]
